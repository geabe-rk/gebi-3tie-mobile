<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission untuk mengakses internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gebi_3TIE_Mobile">

        <!-- Splash Screen sebagai halaman pertama -->
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Auth Activity / Login -->
        <activity
            android:name=".AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 3 -->
        <activity
            android:name=".pertemuan3.ThirdActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".pertemuan3.activity_third_result"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 4 -->
        <activity
            android:name=".pertemuan4.FourthActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 5 -->
        <activity
            android:name=".pertemuan5.FifthActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- WebView -->
        <activity
            android:name=".pertemuan5.WebViewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>